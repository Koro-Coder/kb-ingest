{
  "name": "kb-ingest",
  "version": "1.0.0",
  "description": "Admin tool: register GitHub repos of LaTeX question banks and sync them into the shared knowledge base",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file=.env server/index.js",
    "dev": "node --env-file=.env --watch server/index.js",
    "test": "node --test server/**/*.test.js",
    "migrate": "node --env-file=.env scripts/migrate-kb-data-to-mongo.js"
  },
  "license": "ISC",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0"
  }
}
